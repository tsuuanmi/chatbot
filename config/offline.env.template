# Filled by setup.sh as the canonical root .env. Do not commit generated .env.
INSTALL_DIR=__INSTALL_DIR__
MODEL_DIR=__INSTALL_DIR__/models
CONFIG_DIR=__INSTALL_DIR__/config
RUNTIME_DIR=__INSTALL_DIR__/runtime
HOST_GID=__HOST_GID__
APP_IMAGE=__APP_IMAGE__
LLAMA_CPU_IMAGE=__LLAMA_CPU_IMAGE__
LLAMA_GPU_IMAGE=__LLAMA_GPU_IMAGE__
ACCELERATOR=__ACCELERATOR__
BIND_ADDRESS=0.0.0.0
SERVER_ADDRESS=__SERVER_ADDRESS__
HTTP_PORT=80
CORS_ORIGINS=http://__SERVER_ADDRESS__

LLAMA_API_KEY=__GENERATE__
EMBEDDING_API_KEY=__GENERATE__
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=chatbot

LLAMA_MODEL_NAME=gemma-4-E2B-it-Q4_K_M.gguf
MMPROJ_MODEL=mmproj-gemma-4-E2B-it-bf16.gguf
MTP_MODEL_NAME=mtp-gemma-4-E2B-it.gguf
EMBEDDING_MODEL_NAME=embeddinggemma-300M-Q8_0.gguf
CHROMA_COLLECTION_NAME=chatbot_knowledge
CHROMA_FIGURE_COLLECTION_NAME=chatbot_figures

# Shared CPU/GPU runtime profile. The installer fills accelerator offload layers.
LLAMA_CTX_SIZE=8192
LLAMA_MAX_OUTPUT_TOKENS=2048
# Multimodal projector requires ubatch >= one image-token batch.
LLAMA_BATCH_SIZE=512
LLAMA_UBATCH_SIZE=512
LLAMA_THREADS=8
LLAMA_PARALLEL=1
LLAMA_GPU_LAYERS=__LLAMA_GPU_LAYERS__
LLAMA_GPU_LAYERS_DRAFT=__LLAMA_GPU_LAYERS_DRAFT__
# EmbeddingGemma supports prompts up to its 2048-token context.
EMBEDDING_CTX_SIZE=2048
EMBEDDING_BATCH_SIZE=2048
EMBEDDING_UBATCH_SIZE=2048
EMBEDDING_GPU_LAYERS=__EMBEDDING_GPU_LAYERS__
LLAMA_SPEC_DRAFT_N_MAX=2

FIGURE_DESCRIPTION_MAX_TOKENS=512
DOMAIN_MIN_CONFIDENCE=0.55
DOMAIN_MIN_MARGIN=0.02
DOMAIN_HIGH_RISK_THRESHOLD=0.80
RAG_TOP_K=5
RAG_MAX_DISTANCE=0.85
RAG_MAX_CHARS=2000
HISTORY_TURN_LIMIT=4
STARTUP_MAX_ATTEMPTS=30
STARTUP_RETRY_SECONDS=2
# Serialize GPU generation while allowing five LAN clients to wait safely.
API_MAX_CONCURRENT_REQUESTS=1
API_QUEUE_TIMEOUT_SECONDS=900
