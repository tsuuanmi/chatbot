# Environment
CHATBOT_ENV=production

# Runtime
# Container access to mounted runtime secrets
# Set to the group that owns runtime/secrets on the host.
CHATBOT_SECRET_GID=1000

CHATBOT_RUNTIME_DIR=./runtime
MODEL_DIR=./runtime/models
FIGURE_DIR=./data/figures
MODEL_BUNDLE_VERSION=gemma4-e2b-v2

# Nginx gateway

# llama.cpp
LLAMA_MODEL_NAME=gemma-4-E2B-it-Q4_K_M.gguf
LLAMA_MODEL_ALIAS=forensic-model
LLAMA_MAX_OUTPUT_TOKENS=2048
MMPROJ_MODEL=mmproj-gemma-4-E2B-it-bf16.gguf
LLAMA_CTX_SIZE=8192
LLAMA_BATCH_SIZE=512
LLAMA_UBATCH_SIZE=512
LLAMA_THREADS=8

# Gemma 4 native MTP speculative decoding
MTP_MODEL_NAME=mtp-gemma-4-E2B-it.gguf
LLAMA_SPEC_TYPE=draft-mtp
LLAMA_SPEC_DRAFT_N_MAX=2
LLAMA_GPU_LAYERS_DRAFT=0

# PostgreSQL
POSTGRES_USER=chatbot
POSTGRES_DB=chatbot

# Configured figure description cache
FIGURE_DESCRIPTION_VERSION=1

# CPU embedding
EMBEDDING_THREADS=4

# Conversation persistence
HISTORY_TURN_LIMIT=6

# Conversation context safety limits
HISTORY_CHAR_LIMIT=8000
CHAT_MESSAGE_MAX_CHARS=8000
CHAT_GENERATION_QUEUE_TIMEOUT_SECONDS=5
RAG_MIN_SEMANTIC_SCORE=0.68
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=18080
