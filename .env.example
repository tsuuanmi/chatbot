# LLM Configuration (llama.cpp) — Gemma-4-E2B text + vision model
LLAMA_BASE_URL=http://localhost:8000/v1
LLAMA_API_KEY=local-llama-key
LLAMA_MODEL_NAME=gemma-4-E2B-it-Q4_K_M.gguf
LLAMA_PORT=8000
LLAMA_MAX_LEN=8192
LLAMA_MAX_OUTPUT_TOKENS=4096
LLAMA_CTX_SIZE=32768
LLAMA_THREADS=12
LLAMA_GPU_LAYERS=99
LLAMA_GPU_LAYERS_DRAFT=99

# Multimodal projector (Gemma-4-E2B vision)
MMPROJ_MODEL=mmproj-gemma-4-E2B-it-bf16.gguf

# MTP (Multi-Token Prediction) drafter — speculative decoding acceleration
# Download from the unsloth/gemma-4-E2B-it-GGUF repository.
MTP_MODEL_NAME=mtp-gemma-4-E2B-it.gguf
LLAMA_SPEC_DRAFT_N_MAX=2

# Embedding Configuration — EmbeddingGemma-300M
EMBEDDING_BASE_URL=http://localhost:8001/v1
EMBEDDING_API_KEY=local-embedding-key
EMBEDDING_MODEL_NAME=embeddinggemma-300M-Q8_0.gguf
EMBEDDING_PORT=8001
EMBEDDING_CTX_SIZE=2048
EMBEDDING_BATCH_SIZE=2048
EMBEDDING_UBATCH_SIZE=2048
EMBEDDING_GPU_LAYERS=99

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=chatbot
POSTGRES_PORT=5433
POSTGRES_INTERNAL_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_INTERNAL_PORT}/${POSTGRES_DB}

# ChromaDB HTTP client
CHROMA_HOST=localhost
CHROMA_PORT=8002
CHROMA_COLLECTION_NAME=chatbot_knowledge

# Figure Storage
FIGURES_DIR=./data/figures

# API Configuration
API_BIND_ADDRESS=127.0.0.1
API_HOST=0.0.0.0
API_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
